+ROOT = Path(__file__).resolve().parents[4]
+EVIDENCE = ROOT / "docs/evidence/low-disk-2026-11-14"
+INDEX = EVIDENCE / "artifact-index.json"
+
+EXPECTED = {
+    "inherited/t1-independent/REPORT.md": (
+        "a2ec4da045b9a862744198a5cd002910a145458f9dd4a924a615b0839b7688e0"
+    ),
+    "inherited/t1-independent/facts.json": (
+        "b5f56ebc0f0a7a30467e5bede173de3a3fcd0ebb12e3644e9a05dc73f554a29c"
+    ),
+    "inherited/t1-independent/hash-index.json": (
+        "dfe69bb0625ec4f7d8e89cc9416d12ca45dd33fbbd2387e8598bad8c19bf293b"
