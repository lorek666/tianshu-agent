+        "723098ae0f570c67f59164ee0768113169eea442ea45064cfa670ed062de07d7"
+    ),
+}
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+entries: dict[str, dict[str, int | str]] = {}
+for path in sorted(EVIDENCE.rglob("*")):
+    if not path.is_file() or path == INDEX:
+        continue
+    relative = path.relative_to(EVIDENCE).as_posix()
+    entries[relative] = {
+        "sha256": sha256(path),
+        "bytes": path.stat().st_size,
+        "mode": oct(path.stat().st_mode & 0o777),
+    }
+
+for relative, expected in EXPECTED.items():
+    actual = entries[relative]["sha256"]
+    if actual != expected:
+        raise SystemExit(f"identity mismatch: {relative}: {actual} != {expected}")
+
+payload = {
+    "status": "T3_AUTHOR_EVIDENCE_SEALED_NOT_INDEPENDENT_REVIEW",
+    "head": "a0223aa269efcdf70df4c4d8c43e5629b4fa0215",
+    "root": "docs/evidence/low-disk-2026-11-14",
+    "entry_count_excluding_this_index": len(entries),
+    "identity_bindings_verified": len(EXPECTED),
+    "entries": entries,
+}
+INDEX.write_text(
+    json.dumps(payload, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
+)
+print(
+    f"SEALED {len(entries)} entries; "
+    f"{len(EXPECTED)} inherited/visual identities verified"
+)
