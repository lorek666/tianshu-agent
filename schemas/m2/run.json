{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianshu-agent/schemas/m2/run.json",
  "title": "Run",
  "description": "一次执行。绑定不可变的 goal_revision + lease_epoch，任一与 Task 当前值不符即为被 fence。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "task_id",
    "goal_revision",
    "lease_epoch",
    "state"
  ],
  "properties": {
    "created_at": {
      "type": "integer"
    },
    "effect_state": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "none_applied",
        "applied",
        "partial",
        "unknown",
        null
      ]
    },
    "ended_at": {
      "type": [
        "integer",
        "null"
      ]
    },
    "goal_revision": {
      "type": "integer",
      "minimum": 1
    },
    "lease_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "outcome": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        null
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[0-9a-f]{12}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "created",
        "queued",
        "running",
        "waiting_approval",
        "reconciling",
        "paused",
        "cancelling",
        "succeeded",
        "failed",
        "cancelled",
        "fenced"
      ]
    },
    "task_id": {
      "type": "string"
    },
    "control_requested": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "pause",
        "cancel",
        null
      ],
      "description": "用户控制请求。请求与生效状态分开：RUNNING 时只记录请求，执行器在安全点确认后才改 state。"
    },
    "parent_run_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "子 Run 的父 Run id（G2 子代理 D1）：根 Run 为 null。"
    },
    "subtask_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "子 Run 对应的子任务 slug：根 Run 为 null。"
    }
  }
}
