{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianshu-agent/schemas/m2/task.json",
  "title": "Task",
  "description": "用户可见的最小单位。workspaces 允许为空（纯对话任务）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "goal",
    "goal_revision",
    "lease_epoch",
    "active_run_id",
    "status"
  ],
  "properties": {
    "active_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "integer"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "goal_revision": {
      "type": "integer",
      "minimum": 1
    },
    "lease_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ]
    },
    "task_id": {
      "type": "string",
      "pattern": "^task_[0-9a-f]{12}$"
    },
    "updated_at": {
      "type": "integer"
    },
    "workspaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root_path",
          "mode",
          "snapshot_policy"
        ],
        "properties": {
          "root_path": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "enum": [
              "readonly",
              "writable"
            ]
          },
          "snapshot_policy": {
            "type": "string",
            "enum": [
              "none",
              "on_write"
            ]
          }
        }
      }
    },
    "exec_policy": {
      "type": [
        "object",
        "null"
      ],
      "description": "任务级 ExecPolicy（F2）。null/缺失 = 未配置 = run_command 全拒；开启 exec 是显式动作。"
    },
    "is_control": {
      "type": "boolean",
      "description": "控制面 Run 的持久标记（契约 v1.2，`task.created` 的 control 键）：CLI/UI 直接发起的 Task。只有它能用控制面专属工具与 memory_scopes。"
    },
    "memory_scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^memory://"
      },
      "description": "控制面显式声明的记忆作用域 URI（契约 v1.2）。只对记忆动作生效，不授予任何文件权限；普通任务恒为空数组。"
    },
    "outbound_allow": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^network://(http|https)/"
      },
      "description": "任务级外发白名单（G2）：允许出网的**源**（transport + 主机 + 端口，不带路径）。空 = 一条包都不发；创建后不可改（扩权必须是新任务）。"
    },
    "mcp_servers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_.-]{1,64}$"
      },
      "description": "任务级 MCP server 白名单（G2 MCP 阶段）。空 = 一个都不许；创建时定死、task revise 不可改。"
    },
    "max_subtasks": {
      "type": "integer",
      "enum": [
        0,
        1,
        2,
        3,
        4
      ],
      "description": "任务级委派能力声明（G2 子代理 D1，`task.created` 的必填 max_subtasks）：最多可派生 N 个子任务，0 = 不能委派。未声明即无委派能力；创建后不可改（扩权必须是新任务），每次 spawn 仍需人工批准。"
    },
    "depth": {
      "type": "integer",
      "enum": [
        0,
        1
      ],
      "description": "父链深度（G2 子代理 D1）：根任务 0，子任务恒 1。子任务不能再委派。"
    },
    "parent_task_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "父任务 id（G2 子代理 D1）：根任务为 null。"
    },
    "parent_run_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "派生这个子任务的父 Run id：根任务为 null。"
    },
    "subtask_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "父 Run 作用域内的子任务 slug：根任务为 null。"
    }
  }
}
