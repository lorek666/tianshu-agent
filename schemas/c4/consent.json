{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tianshu-agent/schemas/c4/consent.json",
  "title": "ScopedConsentV1",
  "$defs": {
    "scopedConsent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format_version": {
          "type": "integer",
          "const": 1
        },
        "consent_id": {
          "type": "string",
          "pattern": "^.+$"
        },
        "task_id": {
          "type": "string",
          "pattern": "^.+$"
        },
        "run_id": {
          "type": "string",
          "pattern": "^.+$"
        },
        "goal_revision": {
          "type": "integer",
          "minimum": 1
        },
        "workspace_binding_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "mission_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "action": {
          "type": "string",
          "enum": [
            "overwrite",
            "exec"
          ]
        },
        "tool_binding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tool_id": {
              "type": "string",
              "pattern": "^.+$"
            },
            "version": {
              "type": "string",
              "pattern": "^.+$"
            },
            "schema_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "description_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "tool_id",
            "version",
            "schema_hash",
            "description_hash"
          ]
        },
        "matcher": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "directory_overwrite"
                },
                "directory": {
                  "type": "string",
                  "pattern": "^.+$"
                },
                "directory_identity": {
                  "type": "string",
                  "pattern": "^.+$"
                },
                "recursive": {
                  "type": "boolean"
                },
                "allow_content_changes": {
                  "type": "boolean",
                  "const": true
                },
                "max_file_bytes": {
                  "type": "integer",
                  "minimum": 1
                },
                "max_total_bytes": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "kind",
                "directory",
                "directory_identity",
                "recursive",
                "allow_content_changes",
                "max_file_bytes",
                "max_total_bytes"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "exact_command"
                },
                "executable_path": {
                  "type": "string",
                  "pattern": "^.+$"
                },
                "executable_digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "pattern": "^.+$"
                  }
                },
                "cwd": {
                  "type": "string",
                  "pattern": "^.+$"
                },
                "environment_digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "timeout_ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "isolation_profile_digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "pty": {
                  "type": "boolean"
                }
              },
              "required": [
                "kind",
                "executable_path",
                "executable_digest",
                "argv",
                "cwd",
                "environment_digest",
                "timeout_ms",
                "isolation_profile_digest",
                "pty"
              ]
            }
          ]
        },
        "max_uses": {
          "type": "integer",
          "minimum": 1
        },
        "expires_at": {
          "type": "integer",
          "minimum": 1
        },
        "runtime_session_id": {
          "type": "string",
          "pattern": "^.+$"
        },
        "issued_by": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "actor": {
              "type": "string",
              "pattern": "^.+$"
            },
            "source": {
              "type": "string",
              "const": "cli"
            }
          },
          "required": [
            "actor",
            "source"
          ]
        },
        "request_id": {
          "type": "string",
          "pattern": "^.+$"
        }
      },
      "required": [
        "format_version",
        "consent_id",
        "task_id",
        "run_id",
        "goal_revision",
        "workspace_binding_digest",
        "mission_digest",
        "plan_digest",
        "action",
        "tool_binding",
        "matcher",
        "max_uses",
        "expires_at",
        "runtime_session_id",
        "issued_by",
        "request_id"
      ]
    }
  },
