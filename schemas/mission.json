{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MissionSpecV1",
  "$ref": "#/$defs/mission",
  "$defs": {
    "mission": {
      "type": "object",
      "properties": {
        "format_version": {
          "type": "integer",
          "const": 1
        },
        "mission_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        },
        "goal_revision": {
          "type": "integer",
          "minimum": 1
        },
        "task_kind": {
          "type": "string",
          "enum": [
            "general",
            "coding",
            "research",
            "project_ops",
            "summarize"
          ]
        },
        "user_goal": {
          "type": "string"
        },
        "profile": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "id",
            "version",
            "digest"
          ],
          "additionalProperties": false
        },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "criterion_id": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "machine",
                  "human"
                ]
              }
            },
            "required": [
              "criterion_id",
              "description",
              "mode"
            ],
            "additionalProperties": false
          }
        },
        "tool_allowlist": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tool_id": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "schema_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "description_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "tool_id",
              "version",
              "schema_hash",
              "description_hash"
            ],
            "additionalProperties": false
          }
        },
        "prompt": {
          "type": "object",
          "properties": {
            "template_id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "content_ref": {
              "type": "string",
              "pattern": "^content://sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "template_id",
            "version",
            "digest",
            "content_ref"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "format_version",
        "mission_id",
        "task_id",
        "goal_revision",
        "task_kind",
        "user_goal",
        "profile",
        "criteria",
        "tool_allowlist",
        "prompt"
      ],
      "additionalProperties": false
    }
  }
}
